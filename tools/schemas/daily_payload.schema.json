{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeliveryPayload.Daily",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "generated_at",
    "status",
    "mode",
    "agora",
    "nacao",
    "cortes",
    "perto_de_voce",
    "editor_notes"
  ],
  "properties": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["draft", "approved", "published", "failed"]},
    "mode": {"type": "string", "enum": ["normal", "matchday"]},
    "agora": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "headline", "cards"],
      "properties": {
        "match": {"type": ["object", "null"]},
        "headline": {"type": "string"},
        "cards": {"type": "array", "items": {"type": "object"}}
      }
    },
    "nacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": {"type": "string", "enum": ["ok", "empty"]},
        "items": {"type": "array", "items": {"type": "object"}}
      }
    },
    "cortes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lances", "memes"],
      "properties": {
        "lances": {"type": "array", "items": {"type": "object"}},
        "memes": {"type": "array", "items": {"type": "object"}}
      }
    },
    "perto_de_voce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_city", "status", "items"],
      "properties": {
        "default_city": {"type": "string"},
        "status": {"type": "string", "enum": ["ok", "empty"]},
        "items": {"type": "array", "items": {"type": "object"}}
      }
    },
    "editor_notes": {"type": "array", "items": {"type": "string"}}
  }
}
