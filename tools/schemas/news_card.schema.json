{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcessedOutput.NewsCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id",
    "title",
    "lede",
    "stamp",
    "category",
    "team_unit",
    "source_name",
    "source_url",
    "needs_review",
    "duplicate_of"
  ],
  "properties": {
    "card_id": {"type": "string", "pattern": "^[0-9]{8}-[a-z_]+-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "lede": {"type": "string", "minLength": 1},
    "stamp": {"type": "string", "enum": ["oficial", "confirmado", "rumor", "opiniao", "meme", "ugc"]},
    "category": {
      "type": "string",
      "enum": ["jogo", "mercado", "lesao", "bastidor", "conselho", "institucional", "historia", "meme", "local", "outro"]
    },
    "team_unit": {
      "type": "string",
      "enum": ["profissional_m", "profissional_f", "sub20", "base", "basquete", "volei", "olimpicos", "clube"]
    },
    "source_name": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "minLength": 1},
    "needs_review": {"type": "boolean"},
    "duplicate_of": {"type": ["string", "null"]}
  }
}
