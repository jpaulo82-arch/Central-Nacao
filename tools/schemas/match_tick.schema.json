{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeliveryPayload.MatchTick",
  "type": "object",
  "additionalProperties": false,
  "required": ["match_id", "minute", "type", "text", "score", "publish_without_approval"],
  "properties": {
    "match_id": {"type": "string", "minLength": 1},
    "minute": {"type": "integer", "minimum": 0},
    "type": {"type": "string", "enum": ["goal", "card", "lineup", "kickoff", "ht", "ft"]},
    "text": {"type": "string", "minLength": 1},
    "score": {"type": "string", "minLength": 1},
    "publish_without_approval": {"type": "boolean", "const": true}
  }
}
