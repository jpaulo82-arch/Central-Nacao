generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/central_da_nacao/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Tabela mínima para analytics/cache local se necessário
model PageView {
  id        String   @id @default(cuid())
  path      String
  timestamp DateTime @default(now())

  @@index([path])
  @@index([timestamp])
}
